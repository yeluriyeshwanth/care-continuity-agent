# CareContinuity Backend Configuration

PORT=5001

# Hindsight Agent Memory Configuration
# Use Hindsight Cloud (https://ui.hindsight.vectorize.io) or local instance (http://localhost:8888)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_TENANT=default

# LLM Configuration (Groq or OpenAI)
# Groq offers free tier with high speed: https://groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI Fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
